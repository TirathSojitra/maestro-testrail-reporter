{
  "name": "maestro-testrail-reporter",
  "version": "1.0.0",
  "description": "Sync Maestro mobile test results to TestRail with screenshots, videos and failure reasons",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "maestro-testrail": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build && npm test",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "maestro",
    "testrail",
    "mobile",
    "testing",
    "e2e",
    "reporter",
    "ios",
    "android",
    "automation",
    "ci"
  ],
  "author": "Tirath Sojitra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TirathSojitra/maestro-testrail-reporter"
  },
  "bugs": {
    "url": "https://github.com/TirathSojitra/maestro-testrail-reporter/issues"
  },
  "homepage": "https://github.com/TirathSojitra/maestro-testrail-reporter#readme",
  "dependencies": {
    "axios": "^1.6.7",
    "form-data": "^4.0.0",
    "xml2js": "^0.6.2",
    "commander": "^12.0.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.10",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "nock": "^13.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
